# 缓存类型：auto（默认自动识别）、desktop（Windows 电脑端）、mobile（手机端）
BILIBILI_SOURCE=auto
# Windows Bilibili 客户端默认缓存目录
BILIBILI_CACHE_DIR="%USERPROFILE%\Videos\bilibili"
# 转换结果目录（可自行修改）
OUTPUT_MP4_DIR="%USERPROFILE%\Videos\bilibili-converted"
# FFmpeg 命令名或 ffmpeg.exe 的完整路径
FFMPEG_PATH=ffmpeg
# 并发任务数
MAX_WORKERS=3
# 已有同名 MP4 时跳过
SKIP_EXISTING=true
# 以下仅对手机端有效
MOBILE_FOLDER=false
MOBILE_DANMAKU=false
MOBILE_NFO=false
# MOBILE_DANMAKU=true 时可填写 danmaku2ass.py 或可执行文件路径
DANMAKU2ASS_PATH=
# 仅显示任务，不实际转换
DRY_RUN=false
